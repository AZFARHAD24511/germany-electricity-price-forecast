# Data (large files – keep only small samples or processed summaries)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs & temp
*.log
tmp/
temp/
.cache/

